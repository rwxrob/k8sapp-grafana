#!/usr/bin/env bash
# Build script for k8sapp-grafana.
# Fetches a pinned Grafana Helm chart version, extracts default values,
# then renders manifests with `helm template` for further transformation.

set -euo pipefail

GRAFANA_CHART_VERSION="${GRAFANA_CHART_VERSION:-10.5.15}" # Grafana app 12.3

CHART_REPO_NAME="grafana"
CHART_REPO_URL="https://grafana.github.io/helm-charts"
CHART_NAME="grafana"
RELEASE_NAME="grafana"
NAMESPACE="grafana"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESOURCES_DIR="$ROOT_DIR/resources"
BASE_DIR="$ROOT_DIR/manifests/base"
VALUES_FILE="$RESOURCES_DIR/values-defaults-grafana.yaml"
RENDERED_FILE="$BASE_DIR/grafana.yaml"

mkdir -p "$RESOURCES_DIR" "$BASE_DIR"

if ! command -v helm >/dev/null 2>&1; then
	echo "error: required command 'helm' not found in PATH" >&2
	exit 1
fi

echo "==> Adding/updating Helm repo: $CHART_REPO_NAME ($CHART_REPO_URL)"
helm repo add "$CHART_REPO_NAME" "$CHART_REPO_URL" >/dev/null 2>&1 || true
helm repo update "$CHART_REPO_NAME" >/dev/null

echo "==> Using chart version: $GRAFANA_CHART_VERSION"

echo "==> Writing default values to $VALUES_FILE"
helm show values "$CHART_REPO_NAME/$CHART_NAME" \
	--version "$GRAFANA_CHART_VERSION" >"$VALUES_FILE"

echo "==> Rendering manifests to $RENDERED_FILE"
helm template "$RELEASE_NAME" "$CHART_REPO_NAME/$CHART_NAME" \
	--version "$GRAFANA_CHART_VERSION" \
	--namespace "$NAMESPACE" \
	--values "$VALUES_FILE" |
	yq eval 'del(.. | select(has("namespace")).namespace)' - >"$RENDERED_FILE"

echo "==> Done."
echo "    values:   $VALUES_FILE"
echo "    rendered: $RENDERED_FILE"
